#!/usr/bin/env python3
"""Thin blocking client; identity is explicit or inherited from BRIDGE_AGENT."""
import argparse
import json
import os
import socket
import sys
import time


def laws_text() -> str:
    """Render the room hard laws ("luật cứng") for an agent to read.

    The admin page owns laws.json in the registry dir; this command is
    the agents' read path after the room is told the
    announcement sentence from the admin page's Laws section. No socket round-trip and no key check: the file IS the
    shared state (exactly like agents.json next to it), any agent may
    read it. A missing file means version 0 with no rules yet."""
    registry_dir = os.getenv("BRIDGE_REGISTRY_DIR", "").strip()
    data = {}
    if registry_dir:
        path = os.path.join(registry_dir, "laws.json")
        if os.path.exists(path):
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
    version = int(data.get("version", 0))
    updated = data.get("updated_at")
    when = (time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(updated))
            if updated else "chưa có")
    lines = [f"Luật cứng — phiên bản {version}, cập nhật {when}"]
    for index, rule in enumerate(data.get("rules", []), 1):
        lines.append(f"{index}. {rule.get('text', '')}")
    return "\n".join(lines)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--socket", default=os.getenv("BRIDGE_SOCKET", "/run/bridge.sock"))
    sub = p.add_subparsers(dest="command", required=True)
    for command in ("wait", "say", "ack", "working", "laws"):
        s = sub.add_parser(command)
        # No choices= whitelist here: agent keys come from the hub's
        # effective config/registry (e.g. ga/lu/chim/meo), which only the
        # hub can know. The hub validates the key server-side (Hub._agent)
        # and returns a JSON bad_request error for unknown agents.
        s.add_argument("--agent", default=os.getenv("BRIDGE_AGENT"))
        if command == "wait":
            s.add_argument("--timeout", type=float, default=540)
        elif command == "say":
            s.add_argument("--reply-to", required=True)
            s.add_argument("--part", type=int)
            s.add_argument("--final", action="store_true")
        elif command == "working":
            s.add_argument("id", nargs="?")
            s.add_argument("--eta", type=float)
        elif command == "ack":
            s.add_argument("id")
        # "laws" takes no further arguments: it renders laws.json from
        # the registry dir (see laws_text) and never opens the socket.
    args = vars(p.parse_args())
    path = args.pop("socket")
    if args["command"] == "laws":
        # Local file read (see laws_text): never touches the socket,
        # and any agent key - or none - may read the room's laws.
        try:
            print(laws_text())
        except (OSError, ValueError) as exc:
            print(json.dumps({"error": {"code": "laws_unavailable", "message": str(exc)}}))
            return 1
        return 0
    if not args["agent"]:
        p.error("use --agent or set BRIDGE_AGENT")
    if args["command"] == "say":
        args["content"] = sys.stdin.read(8193)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(path)
            sock.sendall((json.dumps(args, ensure_ascii=False) + "\n").encode("utf-8"))
            with sock.makefile("rb") as stream:
                line = stream.readline(8 * 1024 * 1024)
            response = json.loads(line)
        print(json.dumps(response, ensure_ascii=False))
        return 1 if "error" in response else 0
    except (OSError, ValueError, AttributeError) as exc:
        print(json.dumps({"error": {"code": "connection_failed", "message": str(exc)}}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
