# deploy.env.example — biến môi trường cho các script trong deploy/
# Chép và điền giá trị hạ tầng riêng trước khi chạy build_image.py / create_container.py / switch.py.
# TUYỆT ĐỐI không commit thông tin máy chủ hay bí mật thật vào repo.

# --- Portainer API (bắt buộc khai báo PORTAINER_BASE_URL; để trống sẽ báo lỗi cấu hình) ---
PORTAINER_BASE_URL=
PORTAINER_DOCKER_ENDPOINT=/endpoints/3/docker
PORTAINER_TOKEN_FILE=~/.secrets/portainer_ga_token
# Đường dẫn chứng chỉ CA/cert tự ký của Portainer để ghim xác thực TLS:
PORTAINER_CA_FILE=
# Tên máy chủ TLS (SNI / hostname) có trong SAN của chứng chỉ Portainer khi kết nối qua IP:
PORTAINER_TLS_SERVER_NAME=
# Chỉ đặt =1 khi chấp nhận tắt xác thực TLS (sẽ in cảnh báo ra stderr):
PORTAINER_TLS_INSECURE=

# --- Build & Container v2 ---
DEPLOY_BUILD_CONTEXT_TGZ=/tmp/ctx.tgz
DEPLOY_HUB_IMAGE=discord-hub-v2:trial
DEPLOY_HUB_CONTAINER=discord-hub-v2
DEPLOY_HUB_ENV_FILE=hub.env

# --- SSH Jump & VM chứa cầu v1 (dùng cho switch.py) ---
DEPLOY_JUMP_HOST=
DEPLOY_JUMP_PORT=22
DEPLOY_JUMP_USER=
DEPLOY_VM_HOST=
DEPLOY_VM_PORT=22
DEPLOY_VM_USER=
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# Tùy chọn: file known_hosts bổ sung cho kiểm tra khóa máy chủ SSH (switch.py dùng RejectPolicy):
DEPLOY_KNOWN_HOSTS=
# Tùy chọn: lệnh ProxyCommand cho kết nối SSH tới jump host (để trống nếu đi thẳng):
DEPLOY_PROXY_COMMAND=
DEPLOY_V1_CONTAINERS=discord-bridge discord-bridge-lu discord-bridge-chim
