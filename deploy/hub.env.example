# hub.env.example — chép thành hub.env, điền giá trị thật, chmod 600.
# TUYỆT ĐỐI không commit hub.env thật vào repo.

# --- Agent Lead ---
LEAD_BOT_TOKEN=YOUR_LEAD_BOT_TOKEN
LEAD_BOT_ID=YOUR_BOT_ID
LEAD_CALL_TOKENS=["lead"]
LEAD_DISPLAY_NAME=Lead
LEAD_RECEIVE_DEADLINE=180

# --- Agent Deputy ---
DEPUTY_BOT_TOKEN=YOUR_DEPUTY_BOT_TOKEN
DEPUTY_BOT_ID=YOUR_BOT_ID
DEPUTY_CALL_TOKENS=["deputy"]
DEPUTY_DISPLAY_NAME=Deputy
DEPUTY_RECEIVE_DEADLINE=180

# --- Agent Worker ---
WORKER_BOT_TOKEN=YOUR_WORKER_BOT_TOKEN
WORKER_BOT_ID=YOUR_BOT_ID
WORKER_CALL_TOKENS=["worker"]
WORKER_DISPLAY_NAME=Worker
WORKER_RECEIVE_DEADLINE=300

# --- Phòng ---
GUILD_ID=YOUR_GUILD_ID
CHANNEL_ID=YOUR_CHANNEL_ID
OWNER_ID=YOUR_OWNER_ID

# --- Hub ---
BRIDGE_SOCKET=/run/bridge.sock
BRIDGE_JOURNAL=/data/bridge.jsonl
CONTEXT_COUNT=5
