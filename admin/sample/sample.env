# Sample configuration with NEUTRAL placeholder identities only.
# Legacy env-style agent config (imported once by the registry on first
# boot) plus the admin page's own settings.

AGENT_KEYS=alpha,beta
ALPHA_DISPLAY_NAME=Alpha
ALPHA_BOT_ID=1000000000000000001
ALPHA_CALL_TOKENS=["alpha"]
ALPHA_BOT_TOKEN=
BETA_DISPLAY_NAME=Beta
BETA_BOT_ID=1000000000000000002
BETA_CALL_TOKENS=["beta"]
BETA_RECEIVE_DEADLINE=300
BETA_BOT_TOKEN=

HUB_ADMIN_HOST=127.0.0.1
HUB_ADMIN_PORT=8899
HUB_ADMIN_STATE_DIR=./state
HUB_ADMIN_TOKEN=
HUB_JOURNAL_PATH=./state/bridge.jsonl
